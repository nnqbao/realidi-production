# These ports differ from the plan defaults because 3220, 3221, and
# 6792-6798 are occupied by existing loopback SSH listeners on this host.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3222
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3222
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3223

# Generate this directly into ignored .env.local:
# ./scripts/convex-admin-key.sh
# CONVEX_SELF_HOSTED_ADMIN_KEY=

# The following live in the Convex *deployment* environment, not in this file,
# and are written by ./scripts/convex-auth-env.sh so the key material is never
# echoed. Inspect the names with `npx convex env list --names-only`.
#
#   JWT_PRIVATE_KEY   RS256 signing key for session tokens
#   JWKS              matching public key set, served at /.well-known/jwks.json
#   SITE_URL          origin used to build links in one-time code emails
#   SMTP_HOST         mailpit  (container hostname, reachable from the backend)
#   SMTP_PORT         1025
#   SMTP_FROM         Realidi <no-reply@realidi.local>
#
# Optional, used once to promote the first owner during profile provisioning:
#   INITIAL_OWNER_EMAIL
