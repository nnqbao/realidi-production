# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3020
# Canonical origin for email links and OAuth callbacks (preferred over NEXT_PUBLIC_APP_URL).
APP_URL=http://127.0.0.1:3020
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_DEFAULT_CITY=ho-chi-minh-city
NEXT_PUBLIC_DEFAULT_CURRENCY=VND
NEXT_PUBLIC_DEFAULT_COUNTRY=VN

# Convex Cloud. Copy CONVEX_DEPLOY_KEY from ~/Documents/convex_api.md into
# ignored .env.local. Never commit the key.
CONVEX_DEPLOYMENT=prod:zany-lyrebird-546
# CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=https://zany-lyrebird-546.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://zany-lyrebird-546.convex.site
SITE_URL=http://127.0.0.1:3020

# Cloud SMTP (required for signup/verify/reset email).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=Realidi <no-reply@realidi.local>

# First Owner bootstrap: set to the email of an existing auth user.
# On first login, if no owner exists, that profile is promoted to owner.
INITIAL_OWNER_EMAIL=

# Map provider (Mapbox adapter). Leave empty to disable live maps.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics. console | posthog | none
ANALYTICS_PROVIDER=console
ANALYTICS_KEY=

# Google OAuth is out of scope.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional Playwright role accounts. Values live in ignored .env.local only.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_MODERATOR_EMAIL=
# E2E_MODERATOR_PASSWORD=
# E2E_EDITOR_EMAIL=
# E2E_EDITOR_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_OWNER_EMAIL=
# E2E_OWNER_PASSWORD=
