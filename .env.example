# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical origin for email links and OAuth callbacks (preferred over NEXT_PUBLIC_APP_URL).
APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_DEFAULT_CITY=ho-chi-minh-city
NEXT_PUBLIC_DEFAULT_CURRENCY=VND
NEXT_PUBLIC_DEFAULT_COUNTRY=VN

# Local self-hosted Convex. Defaults use nearby ports because the requested
# 3220/3221 ports are occupied by existing loopback SSH listeners on this host.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3222
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3222
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3223
SITE_URL=http://localhost:3000
AUTH_ISSUER=http://127.0.0.1:3223

# Local auth mail delivery (Mailpit)
# Values as seen by Convex actions on the Compose network.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Realidi <no-reply@realidi.local>

# Leftover product-data runtime. Auth no longer reads these. Never expose
# the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# First Owner bootstrap: set to the email of an existing auth user.
# On first login, if no owner exists, that profile is promoted to owner.
INITIAL_OWNER_EMAIL=

# Map provider (Mapbox adapter). Leave empty to disable live maps.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics. console | posthog | none
ANALYTICS_PROVIDER=console
ANALYTICS_KEY=

# Current optional OAuth flag. Remove only with a completed auth cutover.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional legacy social/demo seed. Credentials JSON is local and ignored.
ENABLE_DEMO_SEED=false
SEED_DEMO_CREDENTIALS_JSON=
